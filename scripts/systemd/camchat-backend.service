# FastAPI backend (:8000). Restart=on-failure brings a crashed process back after 15 s;
# 10 failures in 15 min stop the loop (covers a network that is late at boot), and the
# healthcheck timer then reset-fails + restarts and alerts.
[Unit]
Description=camchat backend (FastAPI)
PartOf=camchat.target
After=camchat-ollama.service
StartLimitIntervalSec=900
StartLimitBurst=10
# The unit's OWN failures (start limit hit, 203/EXEC, OOM) — things a port probe cannot
# see — go to the webhook through the alert template.
OnFailure=camchat-alert@%n.service

[Service]
Type=simple
WorkingDirectory=%h/camchat
ExecStart=%h/camchat/scripts/run-backend.sh
Restart=on-failure
RestartSec=15
# node/python exit 143 on SIGTERM; without this every deliberate stop counts as a failure
# and OnFailure= fires a spurious alert.
SuccessExitStatus=143
TimeoutStopSec=30
KillMode=mixed
StandardOutput=append:%h/camchat/logs/backend/server.out
StandardError=append:%h/camchat/logs/backend/server.err
