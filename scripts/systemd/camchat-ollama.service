# Team-owned ollama on the MIG slice (:11500 per project/.env). Kept as its own unit so a
# backend/frontend bounce never reloads the model; exits 0 (and stays down) when
# project/.env points at a remote ollama. CUDA_VISIBLE_DEVICES comes from scripts/env.local.
[Unit]
Description=camchat ollama (team-owned, MIG slice)
PartOf=camchat.target
StartLimitIntervalSec=900
StartLimitBurst=10
# The unit's OWN failures (start limit hit, 203/EXEC, OOM) — things a port probe cannot
# see — go to the webhook through the alert template.
OnFailure=camchat-alert@%n.service

[Service]
Type=simple
WorkingDirectory=%h/camchat
ExecStart=%h/camchat/scripts/run-ollama.sh
Restart=on-failure
RestartSec=15
# node/python exit 143 on SIGTERM; without this every deliberate stop counts as a failure
# and OnFailure= fires a spurious alert.
SuccessExitStatus=143
TimeoutStopSec=60
KillMode=mixed
StandardOutput=append:%h/camchat/logs/ollama/ollama.out
StandardError=append:%h/camchat/logs/ollama/ollama.err
