# Fired by OnFailure= of the camchat services: posts the failed unit's last status lines to
# the operator webhook (scripts/alert.sh). %i = the failing unit's name.
[Unit]
Description=camchat failure alert for %i

[Service]
Type=oneshot
WorkingDirectory=%h/camchat
ExecStart=/bin/bash -c '%h/camchat/scripts/alert.sh "systemd 유닛 실패: %i" "$(systemctl --user status %i --no-pager -n 8 2>&1 | tail -n 12)"'
