[Unit]
Description=camchat healthcheck every 2 minutes
# Stops with the stack: `systemctl --user stop camchat.target` must not leave a watchdog
# behind that restarts what the operator just stopped.
PartOf=camchat.target

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=15s
Unit=camchat-healthcheck.service

[Install]
WantedBy=timers.target
