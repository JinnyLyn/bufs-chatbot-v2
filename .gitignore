.DS_Store
# KB data committed by choice (2026-06-08): markdown_docs(source), parent_store + qdrant_db
# (regenerable via `python project/reindex.py` — committed for clone-and-run convenience).
backups/
# raw QA live-run output (generated eval artifact; regenerate via qa/run_live.py)
qa/live_runs.jsonl
docs/*
!docs/observability/
!docs/debugging/
__pycache__/
.vscode/
.env
.venv/
venv/

# machine-specific CA bundle (Windows trust store export, for TLS-scanning AV)
win-ca-bundle.pem

# frontend build artifacts / local env
frontend/node_modules/
frontend/.next/
frontend/.env.local

# node deps anywhere + Qdrant runtime lock (regenerated on run)
node_modules/
qdrant_db/.lock
# Word/Office temp lock files
~$*

# test / lint / type-check tooling artifacts (CI-generated, never committed)
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
