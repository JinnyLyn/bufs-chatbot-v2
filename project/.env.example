# ── project/.env 템플릿 ──────────────────────────────────────────────
# 이 파일을 project/.env 로 복사한 뒤 값을 채우세요. 실제 .env 는 .gitignore 로 제외됩니다.
# 모든 값은 env override 이며, 미설정 시 project/config.py 의 기본값이 사용됩니다.

# ── LLM (Ollama) ─────────────────────────────────────────────────────
# 추론 서버 주소. 로컬 GPU 는 :11435, 원격 H100 SSH 터널은 :11434.
#   로컬:  OLLAMA_HOST=127.0.0.1:11435 ollama serve
#   H100:  ssh -N -L 11434:localhost:11434 <user>@<host>
OLLAMA_BASE_URL=http://127.0.0.1:11435
LLM_MODEL=qwen3.5:9b          # 툴콜 가능한 7B+ 권장. config 기본값과 동일.
                              # 작은 GPU면 qwen3:4b-instruct-2507-q4_K_M 으로 낮출 것.
LLM_REASONING=false           # qwen3.5 thinking 끔(추론 토큰이 답변에 새는 것 방지)

# 컨텍스트 창. 큰 KV 캐시는 작은 GPU 에서 CPU 로 스필 → 지연 폭증.
#   로컬 4070(12GB):  8192
#   H100(80GB):       16384  + 아래 BASE_TOKEN_THRESHOLD=12000 (압축 거의 안 함 → 빠름)
LLM_NUM_CTX=8192
BASE_TOKEN_THRESHOLD=2000     # 이 토큰 수 초과 시 compress_context 실행. H100면 12000 권장.

# 생성 안전 캡 (Tier-0). Ollama 기본 num_predict=-1(무제한)이 21K자/284초 폭주를 허용함.
# 정당 답변 출력 max ~718토큰 << 2048 → 정상 트래픽 100% 통과, 폭주만 차단.
LLM_NUM_PREDICT=2048         # 출력 토큰 상한. _eval88_rich 로 정당 답변 안 잘리는지 확인하며 조이기.
LLM_REPEAT_PENALTY=1.1       # 반복 억제(temp=0 greedy 반복루프 차단).
LLM_KEEP_ALIVE=-1            # 모델 VRAM 상주 → 콜드스타트(11.5s rewrite / 43s 트레이스 outlier) 제거.
LLM_WARMUP=true             # 부팅 시 모델 적재(첫 요청 빠르게). CI/테스트나 blackhole 호스트면 false.
# 구조화 출력 방식. prod 9b 박스는 function_calling 고정 → 폴백 재호출(B3) 제거.
# (config 기본 "auto" 는 4b 기본모델 보호용. 4b 는 json_schema/default 경로.)
STRUCTURED_OUTPUT_METHOD=function_calling

# ── 에이전트 루프 / 청킹 ─────────────────────────────────────────────
MAX_TOOL_CALLS=3              # orchestrator 검색/답변 루프 상한 (repo 기본 8)
MAX_ITERATIONS=4             # orchestrator 반복 상한 (repo 기본 10)
MAX_PARENT_SIZE=6000         # 학번 섹션이 한 parent 에 들어가게 (table-aware 청킹)

# ── 검색 / 임베딩 ────────────────────────────────────────────────────
SEARCH_SCORE_THRESHOLD=0.3   # 하이브리드 RRF rank score 대응(top 히트 ≈0.5). 0.7 은 전부 거름.
EMBEDDING_DEVICE=cpu         # 임베딩은 CPU(짧은 쿼리). GPU VRAM 은 LLM 용으로 비워둠.
# DENSE_MODEL=BAAI/bge-m3    # 다국어 임베딩(한국어). 변경 시 차원 바뀌어 재인덱스 필요.

# ── Langfuse 관측 (선택) ─────────────────────────────────────────────
# 1) https://cloud.langfuse.com 에서 프로젝트 생성 후 키 입력
# 2) LANGFUSE_ENABLED=true 로 두고 백엔드 재시작 → 대시보드에 트레이스 표시
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# ⚠ 미설정 시 기본값이 컴포넌트마다 다릅니다:
#   - 백엔드 앱 (project/config.py)    → http://localhost:3000  (로컬 self-hosted 가정)
#   - debug/ 도구 (debug/langfuse_client.py) → https://cloud.langfuse.com  (클라우드 가정)
#   두 쪽을 일치시키려면 아래 주석을 풀고 실제 엔드포인트를 지정하세요.
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU. US 는 https://us.cloud.langfuse.com

# ── 로깅 (선택) ──────────────────────────────────────────────────────
# CHAT_LOG_DISABLED=true      # Q&A JSONL 기록 끔(eval/회귀 실행 시)
# LOG_BACKUP_DAYS=30          # 회전 백엔드 로그 보관일
# BUFS_LOG_DIR=logs           # debug 도구가 app.log·qa.jsonl 을 찾는 루트 (미설정 시 프로젝트 루트의 logs/)
# BUFS_SERVER_URL=http://localhost:8000  # debug/status.py 의 /health 프로브 대상 서버 URL

# ── TLS 우회 (선택, 머신 한정) ──────────────────────────────────────
# AV(예: Norton)가 HTTPS 를 자체 루트로 재서명해 certifi 가 신뢰 못 할 때만.
# Windows 신뢰 저장소에서 내보낸 CA 번들 경로를 지정(절대경로).
# SSL_CERT_FILE=C:/path/to/win-ca-bundle.pem
# REQUESTS_CA_BUNDLE=C:/path/to/win-ca-bundle.pem
