#!/bin/sh
# ────────────────────────────────────────────────────────────────────────
# main 직접 커밋 차단 훅 (WORKFLOW.md 제1원칙 강제)
#
# main = 운영/배포 서버 코드. 여기 직접 커밋하면 막습니다.
# git을 직접 치든, 에이전트(Claude Code/Desktop)가 치든, 똑같이 걸립니다.
#
# ▶ 활성화(각자 한 번만):  git config core.hooksPath .claude/githooks
# ────────────────────────────────────────────────────────────────────────

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# 운영/staging 폴더(scripts/setup-worktrees.sh 가 .deploy-worktree 마커를 둠)에서는 커밋 금지.
# 거긴 태그/origin/main 을 꺼내 두는 곳이지 작업하는 곳이 아니다 (RELEASE.md '폴더 셋').
root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$root" ] && [ -f "$root/.deploy-worktree" ]; then
  echo ""
  echo "  ⛔ 이 폴더는 '$(cat "$root/.deploy-worktree")' 전용 체크아웃입니다 — 여기서 커밋하지 않습니다."
  echo "     개발은 ~/camchat 에서 하세요. (RELEASE.md '폴더 셋')"
  echo ""
  exit 1
fi

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo ""
  echo "  ⛔ '$branch'에 직접 커밋할 수 없습니다 (운영 서버 코드)."
  echo ""
  echo "  새 브랜치를 파서 작업하세요:"
  echo "      git checkout -b feat/내-작업이름"
  echo "      git add -p && git commit ..."
  echo ""
  echo "  방금 한 변경은 그대로 남아 있습니다. 브랜치만 옮기면 됩니다."
  echo "  (자세한 규칙: WORKFLOW.md)"
  echo ""
  exit 1
fi

exit 0
